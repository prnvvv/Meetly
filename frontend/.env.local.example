# Backend origin used for REST and WebSocket
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebRTC STUN server
NEXT_PUBLIC_STUN_SERVER=stun:stun.l.google.com:19302

# Clerk (keys come from https://dashboard.clerk.com -> API keys; never commit real values)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Only PUBLIC values may use the NEXT_PUBLIC_ prefix. Supabase service-role and
# database credentials belong to the backend only; this app talks to Supabase
# exclusively through the Meetly API, so no Supabase key is needed here.

# DEVELOPMENT environment: your own Supabase project (or leave DATABASE_URL empty for SQLite).
# This is the project that may be reset or experimented on. It must NEVER be a project that
# holds real users. Copy to backend/.env (the default file).
APP_ENV=local
AUTH_MODE=clerk
DATABASE_TARGET_ENV=development
# Required as soon as DATABASE_URL points at Supabase: the project ref this checkout may use.
DATABASE_EXPECTED_REF=
DATABASE_URL=
DATABASE_DIRECT_URL=
DATABASE_USE_POOLER=true
DATABASE_SSL_MODE=require
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
FRONTEND_URL=http://localhost:3000
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_KEY_VERSION=1
DATABASE_RLS_ENFORCE=false
FIELD_BLIND_INDEX_KEYS=
FIELD_BLIND_INDEX_KEY_VERSION=1
EMAIL_ENCRYPTION_MODE=off

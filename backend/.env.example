# Backend environment variables. Copy to backend/.env (gitignored) and fill in.
# backend/.env is loaded automatically at startup; real environment variables
# (e.g. on Render) take precedence. NEVER commit real values.

# local | test | staging | production. "production" refuses to boot with unsafe
# settings (demo auth, non-https origins, missing Clerk authorized parties).
APP_ENV=local

# --- Database -------------------------------------------------------------
# Leave DATABASE_URL blank to use the local SQLite file (local dev / tests only).
# Supabase -> Project Settings -> Database -> Connection string.
# App runtime: TRANSACTION pooler (port 6543).
DATABASE_URL=
# Alembic + data migration: SESSION pooler (port 5432) or the direct connection.
DATABASE_DIRECT_URL=
# true when DATABASE_URL points at the transaction pooler (disables prepared statements).
DATABASE_USE_POOLER=true
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# require (TLS) or verify-full (TLS + certificate check; needs the Supabase CA).
DATABASE_SSL_MODE=require

# --- Supabase (backend only; none of these may reach the browser) ----------
SUPABASE_URL=
# Bypasses RLS. Used only for avatar storage. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars

# --- Clerk ------------------------------------------------------------------
# Public key, same value as the frontend's NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY.
CLERK_PUBLISHABLE_KEY=
# Required in production: origins allowed in the token's azp claim.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Optional but recommended: lets the API read a new user's name/email. Secret.
CLERK_SECRET_KEY=
# "clerk" verifies tokens. "demo" skips auth: local dev and tests only.
AUTH_MODE=clerk

# --- Application-level field encryption (AES-256-GCM) -----------------------
# Generate with: python scripts/generate_encryption_key.py 1
# Format: version:key[,version:key...]. The key matching the VERSION encrypts;
# all listed keys decrypt (rotation). Never store these in the database or git.
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_KEY_VERSION=1

# --- App ----------------------------------------------------------------------
# Exact frontend origin(s), comma separated. https only in production.
FRONTEND_URL=http://localhost:3000
STUN_SERVER=stun:stun.l.google.com:19302
APP_NAME=Scalar Meeting API

# Run each request transaction as the low-privilege `meetly_app` role under Row Level
# Security (PostgreSQL only; needs migration 0008 applied). Try it in staging first.
DATABASE_RLS_ENFORCE=false

# --- Account email encryption (see docs/security/EMAIL_ENCRYPTION.md) ---------------------
# Separate key for the HMAC blind index (never reuse FIELD_ENCRYPTION_KEYS).
FIELD_BLIND_INDEX_KEYS=
FIELD_BLIND_INDEX_KEY_VERSION=1
# off (default) | dual | encrypted
EMAIL_ENCRYPTION_MODE=off

# --- Logging -------------------------------------------------------------------------------
# json (default in staging/production) or text; INFO by default. Tokens, keys, emails and
# connection strings are redacted from every log line as a last line of defence.
LOG_FORMAT=
LOG_LEVEL=INFO

# Rate-limit store: memory (one process, exact) or database (shared by all instances, fixed window).
RATE_LIMIT_BACKEND=memory

# --- TURN relay (optional; see docs/deployment/TURN_COTURN.md). Without these only STUN is used.
# Comma separated, e.g. turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=
# The coturn static-auth-secret. Never sent to browsers; short-lived credentials are derived from it.
TURN_SHARED_SECRET=
# Managed TURN provider with one fixed pair instead (used only when TURN_SHARED_SECRET is empty).
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_CREDENTIAL_TTL=3600

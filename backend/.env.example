# Backend environment variables.
# Copy to backend/.env and export these before starting the server, e.g.
#   set -a && . ./.env && set +a      (bash)
#   $env:DATABASE_URL = "..."         (PowerShell)
# This project does not load .env automatically; the app reads os.getenv only.

# SQLite database file. Relative paths are resolved against backend/, so the
# default keeps the database inside backend/data/ regardless of the directory
# the server is started from.
DATABASE_URL=sqlite:///./data/zoom_clone.db

# Frontend origin allowed by CORS. Comma-separate for multiple origins.
FRONTEND_URL=http://localhost:3000,http://192.168.1.10:3000

# STUN server used by WebRTC signaling.
STUN_SERVER=stun:stun.l.google.com:19302

# Display name of the API in /docs.
APP_NAME=Scalar Meeting API

# Authentication. "clerk" (default) verifies Clerk session tokens on every request.
# "demo" skips verification and acts as the seeded demo user: local development
# and tests only, never production.
AUTH_MODE=clerk

# The public Clerk publishable key (same value as the frontend's
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY). The JWKS URL and issuer are derived from it;
# set CLERK_JWKS_URL / CLERK_ISSUER only to override.
CLERK_PUBLISHABLE_KEY=

# Optional. Comma-separated origins allowed in the token's azp claim.
CLERK_AUTHORIZED_PARTIES=

# Optional. Lets the API read a new user's name/email from Clerk. Keep secret.
CLERK_SECRET_KEY=

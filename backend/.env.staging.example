# STAGING environment (its own Supabase project, its own Clerk instance).
# Copy to backend/.env.staging (gitignored) and run with: MEETLY_ENV_FILE=.env.staging
APP_ENV=staging
AUTH_MODE=clerk
DATABASE_TARGET_ENV=staging
# The project ref of the STAGING Supabase project (Settings -> General -> Reference ID).
DATABASE_EXPECTED_REF=
DATABASE_URL=
DATABASE_DIRECT_URL=
DATABASE_USE_POOLER=true
DATABASE_SSL_MODE=require
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=
FRONTEND_URL=
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_KEY_VERSION=1
DATABASE_RLS_ENFORCE=true
